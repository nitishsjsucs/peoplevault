{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development configuration. The Worker name is peoplevault-local so a mistaken
  // `wrangler deploy` without -c can never overwrite the production Worker `peoplevault`.
  // Production uses infra/cloudflare/wrangler.production.template.jsonc, rendered by setup:prod.
  "name": "peoplevault-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // The privacy console (`npm run build:web`; `npm run dev` builds it when stale). Only /api/* and /dev/* invoke the
  // Worker; every other path is a static asset or the console's index.html, served without invoking the Worker.
  "assets": { "directory": "./dist/web", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/dev/*"] },
  "secrets": {
    "required": ["DEV_ACCESS_JWKS", "DEV_ACCESS_PRIVATE_JWK", "PV_PSEUDONYM_MASTER_KEY", "WAREHOUSE_SHIM_TOKEN", "GCP_GATEWAY_SA_KEY"]
  },
  "workflows": [
    { "name": "pv-subject-deletion", "binding": "DELETION", "class_name": "SubjectDeletionWorkflow" },
    { "name": "pv-retention-sweep", "binding": "RETENTION", "class_name": "RetentionSweepWorkflow" }
  ],
  "queues": {
    "producers": [{ "binding": "SWEEP_QUEUE", "queue": "pv-retention-sweep" }],
    "consumers": [
      { "queue": "pv-retention-sweep", "max_batch_size": 25, "max_batch_timeout": 2, "max_retries": 3, "dead_letter_queue": "pv-retention-dlq" }
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pv-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "EXPORTS", "bucket_name": "pv-source-exports" },
    { "binding": "DERIVED", "bucket_name": "pv-derived" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "PV_ENV": "local",
    "AUTH_MODE": "local-jwks",
    "WAREHOUSE_MODE": "local-shim",
    "KV_PROPAGATION_WAIT": "1 second",
    "EXECUTOR_WAIT_TIMEOUT": "1 hour",
    // Free plan capacity (SPEC.md section 30.3.4): "" means unlimited locally, so the local and CI evals are unchanged.
    "DAILY_DELETION_STARTS": "",
    "RETENTION_DAILY_MAX": "",
    "RETENTION_CRON": "on",
    // Decoded R2 bytes per Workflow step, the same caps as production (SPEC.md section 30.3.1).
    "R2_ERASE_STEP_BYTES": "4194304",
    "R2_PROBE_STEP_BYTES": "2097152",
    // Schema-drift triage (SPEC.md section 30.3.6): "stub" or "llama-server" (npm run llm:serve) locally, no cap.
    "AI_MODE": "stub",
    "AI_GATEWAY_ID": "",
    "AI_DAILY_NEURONS": "",
    "LLM_URL": "http://127.0.0.1:8170",
    "RETENTION_AS_OF": "2026-09-30",
    "DEV_ACCESS_ISSUER": "https://dev.peoplevault.test",
    "DEV_ACCESS_AUD": "peoplevault-local",
    "WAREHOUSE_SHIM_URL": "http://127.0.0.1:8893",
    // production-only vars, declared empty so env.ts typechecks under strict mode; "" means unset
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "GCP_PROJECT_ID": "",
    "BQ_LOCATION": "",
    "BQ_GATEWAY_SA_EMAIL": "",
    "BQ_PURPOSE_SA_EMPLOYEE_RELATIONS": "",
    "BQ_PURPOSE_SA_TEAM_MANAGEMENT": "",
    "BQ_PURPOSE_SA_WORKFORCE_ANALYTICS": "",
    "BQ_PURPOSE_SA_PRIVACY_COMPLIANCE": "",
    "BQ_PURPOSE_SA_LEGAL_HOLD_MANAGEMENT": ""
  }
}
