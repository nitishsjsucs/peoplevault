{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production template. `npm run setup:prod` renders it into wrangler.production.jsonc (gitignored, same directory,
  // so the ../../ paths stay valid: wrangler resolves main and migrations_dir relative to this file) with the ids it
  // records in .secrets/prod-resources.json. `npm run deploy:check` dry-runs this template with placeholder ids.
  "name": "peoplevault",
  "main": "../../src/worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs would record the method and URL of every request (3 days on Workers Free); console logs carry
  // no identifiers (test/worker/logging.test.ts).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // The privacy console (`npm run build:web`, which `npm run deploy` and `deploy:check` run first). Only /api/* and
  // /dev/* invoke the Worker; requests for static assets are free and unlimited (SPEC.md section 30.1, F21).
  "assets": { "directory": "../../dist/web", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/dev/*"] },
  // Production secrets only: every listed name becomes an inherit binding at deploy time, uploaded by
  // `wrangler deploy --secrets-file .secrets/worker-secrets.env`.
  "secrets": { "required": ["PV_PSEUDONYM_MASTER_KEY", "GCP_GATEWAY_SA_KEY"] },
  // Workers Free (SPEC.md section 30, ADR 0007): no `limits` block (only the Standard usage model supports it), no
  // `pipelines` binding (Basin Pipelines is Workers Paid only), no Durable Objects. Every Workflow step and request
  // stays under Free's 10 ms of CPU through byte-capped cursor steps (R2_ERASE_STEP_BYTES, R2_PROBE_STEP_BYTES).
  "workflows": [
    { "name": "pv-subject-deletion", "binding": "DELETION", "class_name": "SubjectDeletionWorkflow" },
    { "name": "pv-retention-sweep", "binding": "RETENTION", "class_name": "RetentionSweepWorkflow" }
  ],
  "queues": {
    "producers": [{ "binding": "SWEEP_QUEUE", "queue": "pv-retention-sweep" }],
    "consumers": [
      { "queue": "pv-retention-sweep", "max_batch_size": 25, "max_batch_timeout": 2, "max_retries": 3, "dead_letter_queue": "pv-retention-dlq" }
    ]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "pv-control", "database_id": "__D1_ID__", "migrations_dir": "../../migrations" }],
  "r2_buckets": [
    { "binding": "EXPORTS", "bucket_name": "pv-source-exports" },
    { "binding": "DERIVED", "bucket_name": "pv-derived" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "__KV_ID__" }],
  // Workers AI for the P1 schema-drift triage. Production only: a local AI binding would always call Cloudflare.
  "ai": { "binding": "AI" },
  // The only Cron Trigger: reconcile deferred or orphaned requests, then the retention sweep when RETENTION_CRON=on.
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "PV_ENV": "production",
    "AUTH_MODE": "access",
    "WAREHOUSE_MODE": "bigquery",
    "KV_PROPAGATION_WAIT": "70 seconds",
    "EXECUTOR_WAIT_TIMEOUT": "24 hours",
    // Free plan capacity (SPEC.md section 30.3.4): at most 16 deletion starts per UTC day, 8 of them retention; the
    // retention cron stays off until the production eval result is committed (setup:prod --retention-cron on).
    "DAILY_DELETION_STARTS": "16",
    "RETENTION_DAILY_MAX": "8",
    "RETENTION_CRON": "off",
    // Decoded R2 bytes per Workflow step (SPEC.md section 30.3.1): erase 4 MiB, probe 2 MiB.
    "R2_ERASE_STEP_BYTES": "4194304",
    "R2_PROBE_STEP_BYTES": "2097152",
    // Schema-drift triage (SPEC.md section 30.3.6): Workers AI through the AI Gateway "peoplevault" (no stored logs, no
    // cache), at most 2,000 neurons per UTC day (80% of this repo's 25% share of Free's 10,000).
    "AI_MODE": "workers-ai",
    "AI_GATEWAY_ID": "peoplevault",
    "AI_DAILY_NEURONS": "2000",
    "LLM_URL": "",
    "RETENTION_AS_OF": "",
    "DEV_ACCESS_ISSUER": "",
    "DEV_ACCESS_AUD": "",
    "WAREHOUSE_SHIM_URL": "",
    "ACCESS_TEAM_DOMAIN": "__ACCESS_TEAM_DOMAIN__",
    "ACCESS_AUD": "__ACCESS_AUD__",
    "GCP_PROJECT_ID": "__GCP_PROJECT_ID__",
    "BQ_LOCATION": "US",
    "BQ_GATEWAY_SA_EMAIL": "peoplevault-gateway@__GCP_PROJECT_ID__.iam.gserviceaccount.com",
    "BQ_PURPOSE_SA_EMPLOYEE_RELATIONS": "peoplevault-er-reader@__GCP_PROJECT_ID__.iam.gserviceaccount.com",
    "BQ_PURPOSE_SA_TEAM_MANAGEMENT": "peoplevault-tm-reader@__GCP_PROJECT_ID__.iam.gserviceaccount.com",
    "BQ_PURPOSE_SA_WORKFORCE_ANALYTICS": "peoplevault-wa-reader@__GCP_PROJECT_ID__.iam.gserviceaccount.com",
    "BQ_PURPOSE_SA_PRIVACY_COMPLIANCE": "peoplevault-pc-reader@__GCP_PROJECT_ID__.iam.gserviceaccount.com",
    "BQ_PURPOSE_SA_LEGAL_HOLD_MANAGEMENT": "peoplevault-lh-reader@__GCP_PROJECT_ID__.iam.gserviceaccount.com"
  }
}
